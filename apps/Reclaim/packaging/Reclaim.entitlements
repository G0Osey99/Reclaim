<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime, NO App Sandbox: the sandbox is incompatible with raw
         device access (docs/plan/06 §9), so Reclaim ships outside the Mac App
         Store. No entitlement is required to read block devices — only root,
         which the privileged helper provides. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.get-task-allow</key>
    <false/>
</dict>
</plist>
