# Rust build output
/target
**/*.rs.bk

# Generated golden images + synthetic sample corpus + ground-truth sidecars.
# Images are BUILT, never committed (docs/plan/09 §2, build guide Part 3.4).
/testdata/build/

# Loose disk images / attach shadow files that may land in the tree
*.img
*.dmg.shadow

# Release staging
/dist/

# macOS cruft
.DS_Store

# Session scratch (real sessions live under ~/Library/Application Support/Reclaim)
/sessions/

# Phase 2 fuzz crate build artifacts / corpora (cargo-fuzz, nightly)
crates/reclaim-fs-fuzz/target/
crates/reclaim-fs-fuzz/corpus/
crates/reclaim-fs-fuzz/run-logs/
crates/reclaim-fs-fuzz/artifacts/
crates/reclaim-fs-fuzz/Cargo.lock

# PhotoRec run log (bench competitor output; not a source)
photorec.log

# Compiled APFS snapshot helper (source kept; binary is built on demand)
scripts/apfs-snapshot-helper/snap

# Phase 5 — Swift app build artifacts
apps/Reclaim/Frameworks/*.a
apps/Reclaim/.build/
apps/Reclaim/*.xcodeproj
dist/*.app
dist/*.dmg

# Python bytecode cache
__pycache__/
*.pyc
